---
import SectionTitle from '../ui/SectionTitle.astro';
import { socialLinks } from '../../data/social';
import SocialIcon from '../ui/SocialIcon.astro';
import {useTranslations, type Lang } from '../../i18n/utils';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
  id="contact"
  class="min-h-screen flex items-center justify-start px-4 py-16"
>
  <div class="w-full mx-auto">
    <SectionTitle title={t('contact.title')} />

    <p class="text-slate-500 w-full md:w-2/3 text-justify mb-8">
      {t('contact.description')}
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="space-y-4">
        <div class="flex items-start gap-3">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-mail w-4 h-4 md:w-5 md:h-5 mt-1 text-primary"
          >
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
          <div>
            <h4 class="font-medium text-white">{t('contact.emailLabel')}</h4>
            <p class="text-sm text-slate-400">
              <a href="mailto:fdavid04@icloud.com">fdavid04@icloud.com</a>
            </p>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-map-pin w-4 h-4 md:w-5 md:h-5 mt-1 text-primary"
          >
            <path
              d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"
            ></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <div>
            <h4 class="font-medium text-white">{t('contact.locationLabel')}</h4>
            <p class="text-sm text-slate-400">{t('contact.locationValue')}</p>
          </div>
        </div>
      </div>

      <div>
        <h3 class="text-base md:text-lg font-semibold mb-3 text-white">
          {t('contact.connectTitle')}
        </h3>
        <div class="flex space-x-4">
          {socialLinks.map((link) => <SocialIcon link={link} size="md" />)}
        </div>
      </div>
    </div>
  </div>
</section>
