---
import { socialLinks } from '../../data/social';
import SocialIconHero from '../ui/SocialIconHero.astro';
---

<section
  id="home"
  class="text-center py-20 md:py-20 flex flex-col lg:flex-row items-center justify-between space-y-8 lg:space-y-0 min-h-screen pt-24 md:pt-20"
>
  <div
    class="absolute top-1/4 right-1/4 w-48 h-48 md:w-96 md:h-96 bg-primary/5 rounded-full blur-3xl"
  ></div>
  <div
    class="absolute top-1/4 right-1/4 w-48 h-48 md:w-96 md:h-96 bg-primary/5 rounded-full blur-3xl"
  ></div>

  <div class="flex flex-col items-center lg:items-start space-y-4 w-full lg:w-1/2 order-2 lg:order-1">
    <p class="text-sm text-primary">Hola! yo soy</p>
    <h1 class="text-3xl md:text-4xl lg:text-6xl font-bold mb-4 text-center lg:text-left">
      Francisco
      <span
        class="text-primary relative inline-block after:content-[''] after:block after:w-32 md:after:w-45 after:h-1 after:bg-primary/30 after:mt-2"
        >David</span
      >
    </h1>

    <p class="text-base md:text-lg lg:text-2xl mb-6 text-slate-500 text-center lg:text-justify">
      Full Stack Developer · RPA Developer (UiPath) · Ing. en Sistemas
    </p>

    <div class="flex flex-col md:flex-row space-y-4 md:space-y-0 md:space-x-5 justify-center items-center w-full">
      <div class="flex items-center justify-center space-y-0 space-x-4 w-9/12 md:w-auto">
        <div class="hover:scale-105 flex items-center justify-center w-full sm:w-auto">
          <a
            href="#contact"
            class="bg-primary font-bold text-base md:text-lg py-2 px-6 rounded-xl text-black hover:bg-primary/90 ease-in-out duration-300 w-full sm:w-auto text-center"
          >
            Contactame
          </a>
        </div>
        <div class="hover:scale-105 flex items-center justify-center w-full sm:w-auto">
          <a
            href="#projects"
            class="bg-black font-bold text-base md:text-lg py-2 px-6 rounded-xl text-white border-1 border-slate-800 hover:bg-primary/90 hover:text-black ease-in-out duration-300 w-full sm:w-auto text-center sm:hover:bg-primary/90"
            >Ver Proyectos</a
          >
        </div>
      </div>
      <div class="flex items-center gap-4 mt-4 md:mt-0">
        {socialLinks.map((link) => <SocialIconHero link={link} size="md" />)}
      </div>
    </div>
  </div>

  <div
    class="w-full lg:w-5/12 flex justify-center border-1 border-slate-100 rounded-lg text-slate-400 relative order-2 lg:order-2"
  >
    <div
      class="bg-slate-800 rounded-lg shadow-lg p-3 md:p-6 w-full border border-slate-700 text-start overflow-x-auto"
    >
      <div
        class="absolute inset-0 bg-gradient-to-tr from-primary/20 to-primary/5 rounded-2xl animate-float-up-down -z-20"
      ></div>
      <div class="flex justify-between mb-4 items-center">
        <div class="flex space-x-2">
          <div class="w-2 h-2 md:w-3 md:h-3 bg-red-500 rounded-full hover:scale-110"></div>
          <div class="w-2 h-2 md:w-3 md:h-3 bg-yellow-500 rounded-full hover:scale-110"></div>
          <div class="w-2 h-2 md:w-3 md:h-3 bg-green-500 rounded-full hover:scale-110"></div>
        </div>
        <div class="text-xs md:text-sm text-slate-500">dev.ts</div>
      </div>

      <h1 class="text-sm md:text-xl font-bold text-slate-300 mb-4 text-start">
        <span class="text-rose-500">const</span>
        <span class="text-blue-400">developer</span>:
        <span class="text-red-400">FullStack</span> =
        <span class="text-yellow-400">{'{'}</span>
      </h1>

      <div class="space-y-2 md:space-y-4 ml-3 md:ml-6 text-slate-300 text-xs md:text-base">
        <div class="flex flex-wrap">
          <span class="text-fuchsia-500">nombre</span>:
          <p class="text-green-400 ml-2">'Francisco David'</p>
          ,
        </div>

        <div class="flex flex-wrap">
          <div class="flex">
            <span class="text-fuchsia-500">skills</span>:
            <p class="text-yellow-400 ml-2">[</p>
          </div>
          <ul class="text-slate-300 list-none flex flex-wrap ml-4-custom">
            <li class="text-green-400">'NestJs'</li>
            ,
            <li class="text-green-400">'Node.js'</li>
            ,
            <li class="text-green-400">'React'</li>
            ,
            <li class="text-green-400">'Python'</li>
          </ul>
          <span class="text-yellow-400">]</span>,
        </div>

        <div class="flex flex-wrap">
          <div class="flex">
            <span class="text-fuchsia-500">enfocado</span>:
            <span class="text-yellow-400 ml-2">[</span>
          </div>
          <ul class="text-slate-300 list-none flex flex-wrap">
            <li class="text-green-400">'Backend'</li>
            ,
            <li class="text-green-400">'Automatización RPA'</li>
          </ul>
          <span class="text-yellow-400">]</span>,
        </div>

        <div class="flex flex-wrap">
          <div class="flex">
            <span class="text-fuchsia-500">aprendiendo</span>:
            <span class="text-yellow-400 ml-2">[</span>
          </div>
          <ul class="text-slate-300 list-none flex flex-wrap">
            <li class="text-green-400">'k3s'</li>
            ,
            <li class="text-green-400">'Terraform'</li>
            ,
            <li class="text-green-400">'Redis'</li>
          </ul>
          <span class="text-yellow-400">]</span>,
        </div>
      </div>

      <h1 class="text-sm md:text-xl font-bold text-yellow-400 mt-4">
        {'}'}<span class="text-slate-400">;</span>
      </h1>

      <div class="mt-4 pt-2 border-t border-slate-700">
        <p class="text-slate-500 text-xs md:text-sm break-all">
          <span class="text-green-400">$</span> servidor corriendo en
          <span class="text-blue-400">http://localhost:3000</span>
        </p>
      </div>
    </div>
  </div>
</section>
