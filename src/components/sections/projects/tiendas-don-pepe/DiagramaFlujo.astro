---
// Diagrama de Flujo de Venta y Facturación
// Basado en §3.1 del análisis: login → crear compra → generar PDF
// Sin credenciales, sin endpoints internos específicos
---

<svg
  viewBox="0 0 1200 900"
  role="img"
  aria-labelledby="flow-title flow-desc"
  class="w-full h-auto"
  preserveAspectRatio="xMidYMid meet"
>
  <title id="flow-title">Flujo de venta y facturación</title>
  <desc id="flow-desc">
    Cinco fases: autenticación del operador, registro de la compra con
    validación transaccional de stock, y emisión de la factura en PDF.
  </desc>

  <defs>
    <marker id="f-arr" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <polygon points="0 0, 10 4, 0 8" fill="var(--color-primary)"></polygon>
    </marker>
  </defs>

  <!-- Title -->
  <text x="600" y="40" fill="white" font-size="20" font-family="monospace" text-anchor="middle" font-weight="700">Flujo de Venta y Facturación</text>
  <text x="600" y="62" fill="#94a3b8" font-size="11" font-family="monospace" text-anchor="middle">desde el login del operador hasta el PDF de la factura</text>

  <!-- ====== Phase 1: Login ====== -->
  <g>
    <rect x="60" y="100" width="1080" height="120" rx="10" fill="rgba(0, 255, 136, 0.04)" stroke="var(--color-primary)" stroke-width="1.5"></rect>
    <text x="90" y="124" fill="var(--color-primary)" font-size="10" font-family="monospace" letter-spacing="0.14em">PHASE 1 · LOGIN</text>

    <rect x="100" y="140" width="220" height="60" rx="6" fill="rgba(15, 23, 42, 0.6)" stroke="#475569" stroke-width="1"></rect>
    <text x="210" y="166" fill="white" font-size="14" font-family="monospace" text-anchor="middle" font-weight="700">Operador</text>
    <text x="210" y="186" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle">POST /auth/login</text>

    <rect x="380" y="140" width="220" height="60" rx="6" fill="rgba(15, 23, 42, 0.6)" stroke="#475569" stroke-width="1"></rect>
    <text x="490" y="166" fill="white" font-size="14" font-family="monospace" text-anchor="middle" font-weight="700">AuthService</text>
    <text x="490" y="186" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle">bcrypt.compare + JWT</text>

    <rect x="660" y="140" width="220" height="60" rx="6" fill="rgba(15, 23, 42, 0.6)" stroke="#475569" stroke-width="1"></rect>
    <text x="770" y="166" fill="white" font-size="14" font-family="monospace" text-anchor="middle" font-weight="700">JWT (2h expiry)</text>
    <text x="770" y="186" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle">+ sliding session</text>

    <rect x="940" y="140" width="180" height="60" rx="6" fill="rgba(15, 23, 42, 0.6)" stroke="#475569" stroke-width="1"></rect>
    <text x="1030" y="166" fill="white" font-size="14" font-family="monospace" text-anchor="middle" font-weight="700">MySQL</text>
    <text x="1030" y="186" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle">User + Cliente</text>

    <line x1="320" y1="170" x2="380" y2="170" stroke="var(--color-primary)" stroke-width="1.2" marker-end="url(#f-arr)"></line>
    <line x1="600" y1="170" x2="660" y2="170" stroke="var(--color-primary)" stroke-width="1.2" marker-end="url(#f-arr)"></line>
    <line x1="880" y1="170" x2="940" y2="170" stroke="#475569" stroke-width="1" stroke-dasharray="3,3"></line>
  </g>

  <!-- ====== Phase 2: Crear compra — transaccion ====== -->
  <g>
    <rect x="60" y="260" width="1080" height="280" rx="10" fill="rgba(100, 116, 139, 0.05)" stroke="#475569" stroke-width="1"></rect>
    <text x="90" y="284" fill="#94a3b8" font-size="10" font-family="monospace" letter-spacing="0.14em">PHASE 2 · CREAR COMPRA (transaccional)</text>

    <!-- Operador -->
    <rect x="100" y="310" width="200" height="60" rx="6" fill="rgba(15, 23, 42, 0.6)" stroke="#475569" stroke-width="1"></rect>
    <text x="200" y="336" fill="white" font-size="13" font-family="monospace" text-anchor="middle" font-weight="700">Operador</text>
    <text x="200" y="354" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle">POST /compras</text>

    <!-- ComprasService -->
    <rect x="360" y="310" width="280" height="200" rx="6" fill="rgba(0, 255, 136, 0.04)" stroke="var(--color-primary)" stroke-width="1.5"></rect>
    <rect x="368" y="318" width="100" height="14" rx="2" fill="rgba(0, 255, 136, 0.15)" stroke="var(--color-primary)" stroke-width="0.8"></rect>
    <text x="418" y="328" fill="var(--color-primary)" font-size="8" font-family="monospace" text-anchor="middle" letter-spacing="0.1em">COMPRAS · CORE</text>
    <text x="500" y="358" fill="white" font-size="14" font-family="monospace" text-anchor="middle" font-weight="700">ComprasService</text>
    <text x="500" y="376" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle">startTransaction()</text>

    <!-- Pasos dentro de la transaccion -->
    <rect x="380" y="394" width="240" height="28" rx="3" fill="rgba(15, 23, 42, 0.4)" stroke="#475569" stroke-width="0.5" stroke-dasharray="2,2"></rect>
    <text x="500" y="412" fill="#94a3b8" font-size="9" font-family="monospace" text-anchor="middle">1. validar cliente y tienda</text>

    <rect x="380" y="428" width="240" height="28" rx="3" fill="rgba(15, 23, 42, 0.4)" stroke="var(--color-primary)" stroke-width="0.5"></rect>
    <text x="500" y="446" fill="var(--color-primary)" font-size="9" font-family="monospace" text-anchor="middle">2. validar stock de TODOS</text>

    <rect x="380" y="462" width="240" height="28" rx="3" fill="rgba(15, 23, 42, 0.4)" stroke="var(--color-primary)" stroke-width="0.5"></rect>
    <text x="500" y="480" fill="var(--color-primary)" font-size="9" font-family="monospace" text-anchor="middle">3. descontar stock</text>

    <rect x="380" y="496" width="240" height="28" rx="3" fill="rgba(15, 23, 42, 0.4)" stroke="#475569" stroke-width="0.5" stroke-dasharray="2,2"></rect>
    <text x="500" y="514" fill="#94a3b8" font-size="9" font-family="monospace" text-anchor="middle">4. commit / rollback</text>

    <!-- MySQL con TypeORM -->
    <rect x="700" y="310" width="200" height="200" rx="6" fill="rgba(15, 23, 42, 0.6)" stroke="#475569" stroke-width="1"></rect>
    <rect x="708" y="318" width="80" height="14" rx="2" fill="rgba(100, 116, 139, 0.15)" stroke="#64748b" stroke-width="0.8"></rect>
    <text x="748" y="328" fill="#94a3b8" font-size="8" font-family="monospace" text-anchor="middle" letter-spacing="0.1em">MYSQL 8.0</text>
    <text x="800" y="358" fill="white" font-size="14" font-family="monospace" text-anchor="middle" font-weight="700">TypeORM</text>
    <text x="800" y="376" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle">QueryRunner</text>
    <text x="800" y="394" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle">SELECT stock</text>
    <text x="800" y="412" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle">SELECT stock (check)</text>
    <text x="800" y="430" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle">UPDATE stock</text>
    <text x="800" y="450" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle">INSERT Compra</text>
    <text x="800" y="468" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle">+ DetalleCompra</text>
    <text x="800" y="488" fill="var(--color-primary)" font-size="10" font-family="monospace" text-anchor="middle" font-weight="700">COMMIT</text>

    <rect x="940" y="310" width="180" height="200" rx="6" fill="rgba(15, 23, 42, 0.6)" stroke="#475569" stroke-width="1"></rect>
    <text x="1030" y="350" fill="white" font-size="13" font-family="monospace" text-anchor="middle" font-weight="700">Resultado</text>
    <text x="1030" y="372" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle">Compra OK</text>
    <text x="1030" y="392" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle">o 400 si stock</text>
    <text x="1030" y="408" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle">insuficiente</text>
    <text x="1030" y="438" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle">Atomicidad:</text>
    <text x="1030" y="454" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle">o todo o nada</text>

    <line x1="300" y1="340" x2="360" y2="340" stroke="var(--color-primary)" stroke-width="1.2" marker-end="url(#f-arr)"></line>
    <text x="330" y="332" fill="var(--color-primary)" font-size="9" font-family="monospace">DTO</text>

    <line x1="500" y1="406" x2="700" y2="406" stroke="var(--color-primary)" stroke-width="1" marker-end="url(#f-arr)"></line>
    <line x1="500" y1="440" x2="700" y2="440" stroke="var(--color-primary)" stroke-width="1" marker-end="url(#f-arr)"></line>
    <line x1="500" y1="474" x2="700" y2="474" stroke="var(--color-primary)" stroke-width="1" marker-end="url(#f-arr)"></line>
    <line x1="500" y1="508" x2="700" y2="508" stroke="var(--color-primary)" stroke-width="1" marker-end="url(#f-arr)"></line>

    <line x1="900" y1="470" x2="940" y2="470" stroke="#475569" stroke-width="1" stroke-dasharray="3,3"></line>
  </g>

  <!-- ====== Phase 3: Generar factura PDF ====== -->
  <g>
    <rect x="60" y="580" width="1080" height="220" rx="10" fill="rgba(0, 255, 136, 0.04)" stroke="var(--color-primary)" stroke-width="1.5"></rect>
    <text x="90" y="604" fill="var(--color-primary)" font-size="10" font-family="monospace" letter-spacing="0.14em">PHASE 3 · GENERAR FACTURA PDF</text>

    <rect x="100" y="630" width="180" height="80" rx="6" fill="rgba(15, 23, 42, 0.6)" stroke="#475569" stroke-width="1"></rect>
    <text x="190" y="658" fill="white" font-size="13" font-family="monospace" text-anchor="middle" font-weight="700">Operador</text>
    <text x="190" y="678" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle">GET /facturas/generate/:id</text>
    <text x="190" y="694" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle">AuthGuard + RoleGuard</text>

    <rect x="320" y="630" width="240" height="80" rx="6" fill="rgba(15, 23, 42, 0.6)" stroke="#475569" stroke-width="1"></rect>
    <text x="440" y="658" fill="white" font-size="13" font-family="monospace" text-anchor="middle" font-weight="700">FacturasService</text>
    <text x="440" y="678" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle">map Compra → DTO</text>
    <text x="440" y="694" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle">render template</text>

    <rect x="600" y="630" width="240" height="80" rx="6" fill="rgba(15, 23, 42, 0.6)" stroke="#475569" stroke-width="1"></rect>
    <text x="720" y="658" fill="white" font-size="13" font-family="monospace" text-anchor="middle" font-weight="700">PrinterService</text>
    <text x="720" y="678" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle">pdfmake</text>
    <text x="720" y="694" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle">TDocumentDefinitions</text>

    <rect x="880" y="630" width="240" height="80" rx="6" fill="rgba(0, 255, 136, 0.04)" stroke="var(--color-primary)" stroke-width="1.5"></rect>
    <text x="1000" y="658" fill="white" font-size="13" font-family="monospace" text-anchor="middle" font-weight="700">PDF stream</text>
    <text x="1000" y="678" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle">application/pdf</text>
    <text x="1000" y="694" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle">attachment · factura.pdf</text>

    <line x1="280" y1="670" x2="320" y2="670" stroke="var(--color-primary)" stroke-width="1.2" marker-end="url(#f-arr)"></line>
    <line x1="560" y1="670" x2="600" y2="670" stroke="var(--color-primary)" stroke-width="1.2" marker-end="url(#f-arr)"></line>
    <line x1="840" y1="670" x2="880" y2="670" stroke="var(--color-primary)" stroke-width="1.2" marker-end="url(#f-arr)"></line>

    <text x="600" y="740" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle" letter-spacing="0.1em">Watermark "DOCUMENTO NO FISCAL" · Subtotal + IVA 16% + Total</text>
  </g>

  <!-- ====== Leyenda ====== -->
  <line x1="100" y1="830" x2="1100" y2="830" stroke="#475569" stroke-width="0.8"></line>
  <text x="100" y="850" fill="#94a3b8" font-size="9" font-family="monospace" letter-spacing="0.14em">NOTES</text>
  <text x="200" y="850" fill="#94a3b8" font-size="9" font-family="monospace">Validación de stock en 2 pasos evita vender más de lo disponible ·</text>
  <text x="700" y="850" fill="#94a3b8" font-size="9" font-family="monospace">PDF nunca se persiste en disco</text>
</svg>
