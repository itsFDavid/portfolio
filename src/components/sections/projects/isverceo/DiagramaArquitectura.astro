  <line x1="200" y1="400" x2="460" y2="490" stroke="var(--color-primary)" stroke-width="1.2" marker-end="url(#arr-primary)"></line>
  <line x1="200" y1="400" x2="720" y2="490" stroke="var(--color-primary)" stroke-width="1.2" marker-end="url(#arr-primary)"></line>
  <line x1="200" y1="400" x2="980" y2="490" stroke="var(--color-primary)" stroke-width="1.2" marker-end="url(#arr-primary)"></line>
  <text x="240" y="455" fill="var(--color-primary)" font-size="9" font-family="monospace">RMQ RPC</text>

  <!-- Internal services -> RabbitMQ (todas las que usan RPC/eventos) -->
  <line x1="320" y1="630" x2="200" y2="915" stroke="#475569" stroke-width="1" stroke-dasharray="3,3"></line>
  <line x1="460" y1="630" x2="220" y2="915" stroke="#475569" stroke-width="1" stroke-dasharray="3,3"></line>
  <line x1="720" y1="630" x2="240" y2="915" stroke="#475569" stroke-width="1" stroke-dasharray="3,3"></line>
  <line x1="980" y1="630" x2="260" y2="915" stroke="#475569" stroke-width="1" stroke-dasharray="3,3"></line>
  <line x1="200" y1="750" x2="180" y2="875" stroke="#475569" stroke-width="1" stroke-dasharray="3,3"></line>
  <line x1="460" y1="750" x2="200" y2="875" stroke="#475569" stroke-width="1" stroke-dasharray="3,3"></line>

  <!-- auth-ms / encrypt-ms / deployments-ms -> Redis -->
  <line x1="460" y1="750" x2="400" y2="875" stroke="#64748b" stroke-width="1" stroke-dasharray="3,3"></line>

  <!-- Internal -> Postgres (Prisma) -->
  <line x1="460" y1="630" x2="620" y2="875" stroke="#475569" stroke-width="1" stroke-dasharray="3,3"></line>
  <line x1="720" y1="630" x2="640" y2="875" stroke="#475569" stroke-width="1" stroke-dasharray="3,3"></line>
  <line x1="980" y1="630" x2="660" y2="875" stroke="#64748b" stroke-width="1" stroke-dasharray="3,3"></line>
  <line x1="600" y1="400" x2="640" y2="875" stroke="#475569" stroke-width="1" stroke-dasharray="3,3"></line>
  <line x1="1000" y1="400" x2="660" y2="875" stroke="#475569" stroke-width="1" stroke-dasharray="3,3"></line>

  <!-- email-ms -> Resend -->
  <line x1="200" y1="750" x2="540" y2="110" stroke="#475569" stroke-width="1" stroke-dasharray="3,3"></line>
  <text x="300" y="450" fill="#94a3b8" font-size="9" font-family="monospace">HTTPS</text>

  <!-- deployments-ms -> Swarm (deploy) -->
  <line x1="980" y1="630" x2="1050" y2="875" stroke="var(--color-primary)" stroke-width="1.2" marker-end="url(#arr-primary)"></line>
  <text x="1080" y="760" fill="var(--color-primary)" font-size="9" font-family="monospace">docker stack</text>
</svg>
