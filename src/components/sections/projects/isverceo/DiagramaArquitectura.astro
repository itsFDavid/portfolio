---
// Diagrama de Arquitectura - IsVerceo PaaS
// Vista simplificada del mermaid del análisis técnico, sin valores
// sensibles ni nombres de variables de entorno
---

<svg
  viewBox="0 0 1200 1000"
  role="img"
  aria-labelledby="arch-title arch-desc"
  class="w-full h-auto"
  preserveAspectRatio="xMidYMid meet"
>
  <title id="arch-title">Arquitectura de IsVerceo — PaaS de microservicios</title>
  <desc id="arch-desc">
    9 microservicios NestJS detrás de un gateway HTTP público, comunicados
    por RabbitMQ. PostgreSQL, Redis, registry privado y Docker Swarm en
    redes separadas.
  </desc>

  <defs>
    <marker id="arr-primary" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <polygon points="0 0, 10 4, 0 8" fill="var(--color-primary)"></polygon>
    </marker>
    <marker id="arr-muted" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <polygon points="0 0, 10 4, 0 8" fill="#64748b"></polygon>
    </marker>
  </defs>

  <!-- ====== External ====== -->
  <g>
    <text x="60" y="40" fill="#94a3b8" font-size="10" font-family="monospace" letter-spacing="0.14em">EXTERNAL</text>

    <rect x="60" y="60" width="160" height="50" rx="6" fill="rgba(30, 41, 59, 0.5)" stroke="#475569" stroke-width="1"></rect>
    <text x="140" y="82" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle" letter-spacing="0.1em">USER / FRONTEND</text>
    <text x="140" y="98" fill="#cbd5e1" font-size="11" font-family="monospace" text-anchor="middle">isverceo.com</text>

    <rect x="240" y="60" width="100" height="50" rx="6" fill="rgba(30, 41, 59, 0.5)" stroke="#475569" stroke-width="1"></rect>
    <text x="290" y="82" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle" letter-spacing="0.1em">GITHUB</text>
    <text x="290" y="98" fill="#cbd5e1" font-size="11" font-family="monospace" text-anchor="middle">webhooks</text>

    <rect x="360" y="60" width="100" height="50" rx="6" fill="rgba(30, 41, 59, 0.5)" stroke="#475569" stroke-width="1"></rect>
    <text x="410" y="82" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle" letter-spacing="0.1em">STRIPE</text>
    <text x="410" y="98" fill="#cbd5e1" font-size="11" font-family="monospace" text-anchor="middle">webhook</text>

    <rect x="480" y="60" width="120" height="50" rx="6" fill="rgba(30, 41, 59, 0.5)" stroke="#475569" stroke-width="1"></rect>
    <text x="540" y="82" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle" letter-spacing="0.1em">RESEND</text>
    <text x="540" y="98" fill="#cbd5e1" font-size="11" font-family="monospace" text-anchor="middle">email API</text>
  </g>

  <!-- ====== Edge / Traefik ====== -->
  <g>
    <rect x="60" y="160" width="1140" height="80" rx="10" fill="rgba(100, 116, 139, 0.05)" stroke="#475569" stroke-width="1" stroke-dasharray="4,3"></rect>
    <text x="90" y="184" fill="#94a3b8" font-size="10" font-family="monospace" letter-spacing="0.14em">EDGE PROXY</text>

    <rect x="540" y="170" width="180" height="60" rx="6" fill="rgba(15, 23, 42, 0.6)" stroke="var(--color-primary)" stroke-width="1.5"></rect>
    <text x="630" y="194" fill="var(--color-primary)" font-size="9" font-family="monospace" text-anchor="middle" letter-spacing="0.1em">TRAEFIK</text>
    <text x="630" y="212" fill="white" font-size="14" font-family="monospace" text-anchor="middle" font-weight="700">Edge Proxy</text>
    <text x="630" y="226" fill="#94a3b8" font-size="9" font-family="monospace" text-anchor="middle">TLS termination · routing</text>
  </g>

  <!-- Conexiones external -> traefik -->
  <line x1="140" y1="110" x2="540" y2="170" stroke="var(--color-primary)" stroke-width="1.2" marker-end="url(#arr-primary)"></line>
  <line x1="290" y1="110" x2="555" y2="170" stroke="#475569" stroke-width="1" stroke-dasharray="3,3"></line>
  <line x1="410" y1="110" x2="610" y2="170" stroke="#475569" stroke-width="1" stroke-dasharray="3,3"></line>
  <text x="320" y="148" fill="#94a3b8" font-size="9" font-family="monospace">webhooks</text>

  <!-- ====== Public services (expuestos a internet) ====== -->
  <g>
    <text x="60" y="280" fill="#94a3b8" font-size="10" font-family="monospace" letter-spacing="0.14em">PUBLIC SERVICES (edge network)</text>

    <rect x="60" y="300" width="280" height="100" rx="8" fill="rgba(0, 255, 136, 0.04)" stroke="var(--color-primary)" stroke-width="1.5"></rect>
    <rect x="68" y="308" width="76" height="14" rx="2" fill="rgba(0, 255, 136, 0.15)" stroke="var(--color-primary)" stroke-width="0.8"></rect>
    <text x="106" y="318" fill="var(--color-primary)" font-size="8" font-family="monospace" text-anchor="middle" letter-spacing="0.1em">gateway</text>
    <text x="200" y="346" fill="white" font-size="16" font-family="monospace" text-anchor="middle" font-weight="700">Gateway</text>
    <text x="200" y="364" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle">HTTP REST · :3000</text>
    <text x="200" y="380" fill="#64748b" font-size="9" font-family="monospace" text-anchor="middle">Único endpoint público</text>

    <rect x="460" y="300" width="280" height="100" rx="8" fill="rgba(15, 23, 42, 0.6)" stroke="#475569" stroke-width="1"></rect>
    <rect x="468" y="308" width="76" height="14" rx="2" fill="rgba(100, 116, 139, 0.15)" stroke="#64748b" stroke-width="0.8"></rect>
    <text x="506" y="318" fill="#94a3b8" font-size="8" font-family="monospace" text-anchor="middle" letter-spacing="0.1em">github-ms</text>
    <text x="600" y="346" fill="white" font-size="16" font-family="monospace" text-anchor="middle" font-weight="700">GitHub Service</text>
    <text x="600" y="364" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle">/api/webhooks/github</text>
    <text x="600" y="380" fill="#64748b" font-size="9" font-family="monospace" text-anchor="middle">HTTP webhook only</text>

    <rect x="860" y="300" width="280" height="100" rx="8" fill="rgba(15, 23, 42, 0.6)" stroke="#475569" stroke-width="1"></rect>
    <rect x="868" y="308" width="80" height="14" rx="2" fill="rgba(100, 116, 139, 0.15)" stroke="#64748b" stroke-width="0.8"></rect>
    <text x="908" y="318" fill="#94a3b8" font-size="8" font-family="monospace" text-anchor="middle" letter-spacing="0.1em">payments-ms</text>
    <text x="1000" y="346" fill="white" font-size="16" font-family="monospace" text-anchor="middle" font-weight="700">Payments</text>
    <text x="1000" y="364" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle">/api/payments/webhook</text>
    <text x="1000" y="380" fill="#64748b" font-size="9" font-family="monospace" text-anchor="middle">Stripe webhook only</text>
  </g>

  <!-- Traefik -> public services -->
  <line x1="500" y1="230" x2="200" y2="300" stroke="var(--color-primary)" stroke-width="1.2" marker-end="url(#arr-primary)"></line>
  <line x1="680" y1="230" x2="600" y2="300" stroke="#475569" stroke-width="1" stroke-dasharray="3,3"></line>
  <line x1="780" y1="230" x2="1000" y2="300" stroke="#475569" stroke-width="1" stroke-dasharray="3,3"></line>

  <!-- ====== Internal services (red interna, NO expuestos) ====== -->
  <g>
    <text x="60" y="450" fill="#94a3b8" font-size="10" font-family="monospace" letter-spacing="0.14em">INTERNAL MICROSERVICES (no expuestos a internet)</text>

    <rect x="60" y="470" width="1080" height="180" rx="10" fill="rgba(100, 116, 139, 0.03)" stroke="#475569" stroke-width="1" stroke-dasharray="4,3"></rect>

    <!-- Row 1: auth, users, projects, deployments -->
    <g>
      <rect x="80" y="490" width="240" height="140" rx="6" fill="rgba(15, 23, 42, 0.6)" stroke="#475569" stroke-width="1"></rect>
      <rect x="88" y="498" width="64" height="14" rx="2" fill="rgba(100, 116, 139, 0.15)" stroke="#64748b" stroke-width="0.8"></rect>
      <text x="120" y="508" fill="#94a3b8" font-size="8" font-family="monospace" text-anchor="middle" letter-spacing="0.1em">auth-ms</text>
      <text x="200" y="540" fill="white" font-size="14" font-family="monospace" text-anchor="middle" font-weight="700">Auth</text>
      <text x="200" y="558" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle">OAuth GitHub</text>
      <text x="200" y="574" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle">JWT firmado + cifrado</text>
      <text x="200" y="596" fill="#64748b" font-size="9" font-family="monospace" text-anchor="middle">Sesiones en Redis</text>
    </g>

    <g>
      <rect x="340" y="490" width="240" height="140" rx="6" fill="rgba(15, 23, 42, 0.6)" stroke="#475569" stroke-width="1"></rect>
      <rect x="348" y="498" width="72" height="14" rx="2" fill="rgba(100, 116, 139, 0.15)" stroke="#64748b" stroke-width="0.8"></rect>
      <text x="384" y="508" fill="#94a3b8" font-size="8" font-family="monospace" text-anchor="middle" letter-spacing="0.1em">users-ms</text>
      <text x="460" y="540" fill="white" font-size="14" font-family="monospace" text-anchor="middle" font-weight="700">Users</text>
      <text x="460" y="558" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle">CRUD usuarios</text>
      <text x="460" y="574" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle">Tenants / membresías</text>
      <text x="460" y="596" fill="#64748b" font-size="9" font-family="monospace" text-anchor="middle">Prisma · Postgres</text>
    </g>

    <g>
      <rect x="600" y="490" width="240" height="140" rx="6" fill="rgba(15, 23, 42, 0.6)" stroke="#475569" stroke-width="1"></rect>
      <rect x="608" y="498" width="84" height="14" rx="2" fill="rgba(100, 116, 139, 0.15)" stroke="#64748b" stroke-width="0.8"></rect>
      <text x="650" y="508" fill="#94a3b8" font-size="8" font-family="monospace" text-anchor="middle" letter-spacing="0.1em">projects-ms</text>
      <text x="720" y="540" fill="white" font-size="14" font-family="monospace" text-anchor="middle" font-weight="700">Projects</text>
      <text x="720" y="558" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle">CRUD proyectos</text>
      <text x="720" y="574" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle">Dominios · env vars</text>
      <text x="720" y="596" fill="#64748b" font-size="9" font-family="monospace" text-anchor="middle">Prisma · Postgres</text>
    </g>

    <g>
      <rect x="860" y="490" width="240" height="140" rx="6" fill="rgba(0, 255, 136, 0.04)" stroke="var(--color-primary)" stroke-width="1.5"></rect>
      <rect x="868" y="498" width="104" height="14" rx="2" fill="rgba(0, 255, 136, 0.15)" stroke="var(--color-primary)" stroke-width="0.8"></rect>
      <text x="920" y="508" fill="var(--color-primary)" font-size="8" font-family="monospace" text-anchor="middle" letter-spacing="0.1em">deployments-ms</text>
      <text x="980" y="540" fill="white" font-size="14" font-family="monospace" text-anchor="middle" font-weight="700">Deployments</text>
      <text x="980" y="558" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle">Núcleo del PaaS</text>
      <text x="980" y="574" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle">Clone · Build · Deploy</text>
      <text x="980" y="596" fill="#64748b" font-size="9" font-family="monospace" text-anchor="middle">Nixpacks / Railpack</text>
    </g>
  </g>

  <!-- Row 2: email, encrypt -->
  <g>
    <rect x="80" y="700" width="240" height="100" rx="6" fill="rgba(15, 23, 42, 0.6)" stroke="#475569" stroke-width="1"></rect>
    <rect x="88" y="708" width="72" height="14" rx="2" fill="rgba(100, 116, 139, 0.15)" stroke="#64748b" stroke-width="0.8"></rect>
    <text x="124" y="718" fill="#94a3b8" font-size="8" font-family="monospace" text-anchor="middle" letter-spacing="0.1em">email-ms</text>
    <text x="200" y="744" fill="white" font-size="14" font-family="monospace" text-anchor="middle" font-weight="700">Email</text>
    <text x="200" y="762" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle">Emails transaccionales</text>
    <text x="200" y="780" fill="#64748b" font-size="9" font-family="monospace" text-anchor="middle">vía Resend</text>

    <rect x="340" y="700" width="240" height="100" rx="6" fill="rgba(0, 255, 136, 0.04)" stroke="var(--color-primary)" stroke-width="1.5"></rect>
    <rect x="348" y="708" width="80" height="14" rx="2" fill="rgba(0, 255, 136, 0.15)" stroke="var(--color-primary)" stroke-width="0.8"></rect>
    <text x="388" y="718" fill="var(--color-primary)" font-size="8" font-family="monospace" text-anchor="middle" letter-spacing="0.1em">encrypt-ms</text>
    <text x="460" y="744" fill="white" font-size="14" font-family="monospace" text-anchor="middle" font-weight="700">Encryption</text>
    <text x="460" y="762" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle">AES-256-GCM</text>
    <text x="460" y="780" fill="#9448b8" font-size="9" font-family="monospace" text-anchor="middle" fill="#94a3b8">Rotación de claves</text>
  </g>

  <!-- ====== Infra (Postgres, Redis, RabbitMQ, Registry) ====== -->
  <g>
    <text x="60" y="855" fill="#94a3b8" font-size="10" font-family="monospace" letter-spacing="0.14em">INFRASTRUCTURE (internal network)</text>

    <g>
      <rect x="80" y="875" width="200" height="80" rx="6" fill="rgba(15, 23, 42, 0.6)" stroke="#475569" stroke-width="1"></rect>
      <rect x="88" y="883" width="64" height="14" rx="2" fill="rgba(100, 116, 139, 0.15)" stroke="#64748b" stroke-width="0.8"></rect>
      <text x="120" y="893" fill="#94a3b8" font-size="8" font-family="monospace" text-anchor="middle" letter-spacing="0.1em">RabbitMQ</text>
      <text x="180" y="920" fill="white" font-size="13" font-family="monospace" text-anchor="middle" font-weight="700">Message Broker</text>
      <text x="180" y="936" fill="#64748b" font-size="9" font-family="monospace" text-anchor="middle">Durable queues</text>
    </g>

    <g>
      <rect x="300" y="875" width="200" height="80" rx="6" fill="rgba(15, 23, 42, 0.6)" stroke="#475569" stroke-width="1"></rect>
      <rect x="308" y="883" width="48" height="14" rx="2" fill="rgba(100, 116, 139, 0.15)" stroke="#64748b" stroke-width="0.8"></rect>
      <text x="332" y="893" fill="#94a3b8" font-size="8" font-family="monospace" text-anchor="middle" letter-spacing="0.1em">Redis</text>
      <text x="400" y="920" fill="white" font-size="13" font-family="monospace" text-anchor="middle" font-weight="700">Cache + Pub/Sub</text>
      <text x="400" y="936" fill="#64748b" font-size="9" font-family="monospace" text-anchor="middle">Sessions · rate-limit</text>
    </g>

    <g>
      <rect x="520" y="875" width="200" height="80" rx="6" fill="rgba(15, 23, 42, 0.6)" stroke="#475569" stroke-width="1"></rect>
      <rect x="528" y="883" width="80" height="14" rx="2" fill="rgba(100, 116, 139, 0.15)" stroke="#64748b" stroke-width="0.8"></rect>
      <text x="568" y="893" fill="#94a3b8" font-size="8" font-family="monospace" text-anchor="middle" letter-spacing="0.1em">PostgreSQL 15</text>
      <text x="620" y="920" fill="white" font-size="13" font-family="monospace" text-anchor="middle" font-weight="700">Primary DB</text>
      <text x="620" y="936" fill="#64748b" font-size="9" font-family="monospace" text-anchor="middle">5 esquemas Prisma</text>
    </g>

    <g>
      <rect x="740" y="875" width="200" height="80" rx="6" fill="rgba(15, 23, 42, 0.6)" stroke="#475569" stroke-width="1"></rect>
      <rect x="748" y="883" width="104" height="14" rx="2" fill="rgba(100, 116, 139, 0.15)" stroke="#64748b" stroke-width="0.8"></rect>
      <text x="800" y="893" fill="#94a3b8" font-size="8" font-family="monospace" text-anchor="middle" letter-spacing="0.1em">Docker Registry</text>
      <text x="840" y="920" fill="white" font-size="13" font-family="monospace" text-anchor="middle" font-weight="700">Private Registry</text>
      <text x="840" y="936" fill="#64748b" font-size="9" font-family="monospace" text-anchor="middle">tenant/&#123;tenantId&#125;/&#123;projectId&#125;</text>
    </g>

    <g>
      <rect x="960" y="875" width="180" height="80" rx="6" fill="rgba(0, 255, 136, 0.04)" stroke="var(--color-primary)" stroke-width="1.5"></rect>
      <rect x="968" y="883" width="80" height="14" rx="2" fill="rgba(0, 255, 136, 0.15)" stroke="var(--color-primary)" stroke-width="0.8"></rect>
      <text x="1008" y="893" fill="var(--color-primary)" font-size="8" font-family="monospace" text-anchor="middle" letter-spacing="0.1em">Docker Swarm</text>
      <text x="1050" y="920" fill="white" font-size="13" font-family="monospace" text-anchor="middle" font-weight="700">Cluster</text>
      <text x="1050" y="936" fill="#64748b" font-size="9" font-family="monospace" text-anchor="middle">tenant apps</text>
    </g>
  </g>

  <!-- ====== Conexiones clave (simplificadas) ====== -->
  <!-- Gateway -> RabbitMQ (representada con líneas hacia auth/users/projects) -->
