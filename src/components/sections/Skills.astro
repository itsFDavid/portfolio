---
import type { ResolvedSkill, Skill } from '../../data/skills';
import SectionTitle from '../ui/SectionTitle.astro';
import SkillCard from '../cards/SkillCard.astro';
import { useTranslations, type Lang } from '../../i18n/utils';

export interface Props {
  skills: ResolvedSkill[];
  lang: Lang;
}

const { skills, lang } = Astro.props;
const t = useTranslations(lang);
---

<section
  id="skills"
  class="min-h-screen flex items-center justify-start px-4 py-16"
>
  <div class="w-full mx-auto">
    <SectionTitle title={t('skills.title')} />

    <p class="text-slate-500 w-full md:w-2/3 text-justify mb-8">
      {t('skills.description')}
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
      {skills.map((skill) => <SkillCard skill={skill} />)}
    </div>
  </div>
</section>
