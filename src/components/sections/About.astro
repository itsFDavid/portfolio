---
import SectionTitle from '../ui/SectionTitle.astro';
import Tag from '../ui/Tag.astro';

const skills = ['React', 'NestJs', 'Node.js', 'Python'];
---

<section
  id="about"
  class="min-h-screen flex items-center justify-start px-4 py-16"
>
  <div class="w-full mx-auto">
    <SectionTitle title="Acerca de mí" />

    <div class="flex flex-col lg:flex-row w-full justify-between items-start space-y-8 lg:space-y-0 lg:space-x-8">
      <div class="space-y-6 w-full lg:w-8/12">
        <div>
          <h3 class="text-lg md:text-xl mb-2 flex items-center gap-2">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="lucide lucide-file-text w-4 h-4 md:w-5 md:h-5 text-primary"
            >
              <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path>
              <path d="M14 2v4a2 2 0 0 0 2 2h4"></path>
              <path d="M10 9H8"></path>
              <path d="M16 13H8"></path>
              <path d="M16 17H8"></path>
            </svg>
            Bio
          </h3>
          <p class="text-base md:text-lg text-slate-500 mb-6 text-justify">
            Apasionado por el backend (NestJS, microservicios) y la
            automatización con UiPath. Disfruto enfrentar problemas nuevos
            y aprender en el camino. Estudiante de Ing. en Sistemas.
          </p>
        </div>

        <div class="flex gap-6">
          <div
            class="rounded-lg w-full border text-slate-400 shadow-sm h-full border-primary/10 bg-background/50 hover:-translate-y-3 transition-transform duration-300"
          >
            <div class="p-4 md:p-6 pt-4 md:pt-6">
              <h3 class="text-base md:text-lg text-white flex items-center gap-2 mb-3">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="lucide lucide-graduation-cap w-4 h-4 md:w-5 md:h-5 text-primary"
                >
                  <path
                    d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"
                  ></path>
                  <path d="M22 10v6"></path>
                  <path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"></path>
                </svg>
                Educación
              </h3>
              <div class="space-y-4">
                <div class="space-y-2">
                  <p class="text-white text-sm md:text-md">Tecnico en Computación</p>
                  <p class="text-xs md:text-sm">
                    CECyTEM (Colegio de Estudios Cientificos y Tecnologicos del
                    Estado de México)
                  </p>
                  <p class="text-xs md:text-sm">2019 - 2022</p>
                </div>
                <div class="space-y-2">
                  <p class="text-white text-sm md:text-md">
                    Ingeniería en Sistemas Computacionales
                  </p>
                  <p class="text-xs md:text-sm">
                    TESJI (Tecnologico de Estudios Superiores de Jilotepec)
                  </p>
                  <p class="text-xs md:text-sm">2022 - Presente</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="flex flex-col items-center lg:items-start w-full lg:w-3/12">
        <div class="mb-6">
          <img
            src="/images/francisco_david.webp"
            alt="Francisco David"
            class="w-32 h-32 md:w-40 md:h-40 lg:w-50 lg:h-50 aspect-square rounded-full border-4 border-primary/20 shadow-lg object-cover hover:scale-105 transition-transform duration-300"
          />
        </div>
        <div class="text-center lg:text-left mb-5">
          <h3 class="text-xl md:text-2xl mb-1">Francisco David</h3>
          <p class="text-slate-500 text-sm">Full Stack Developer</p>
          <p class="text-slate-500 text-sm">
            Estudiante de Ingeniera en Sistemas
          </p>
        </div>
        
        <div>
          <a
            href="/cv/CV_Francisco_David.pdf"
            download="CV_Francisco_David.pdf"
            class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-black hover:bg-primary/90 h-10 px-4 py-2 gap-2 hover:scale-105 ease-in-out duration-1000 w-full lg:w-auto"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="lucide lucide-download w-4 h-4"
            >
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" x2="12" y1="15" y2="3"></line>
            </svg>
            Download Resume
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
