---
export interface Props {
  email: string;
  password: string;
  nota?: string;
  demoUrl?: string;
}

const { email, password, nota, demoUrl } = Astro.props;
---

<section class="mb-8">
  <div
    class="border border-primary/30 rounded-lg p-6 md:p-8 bg-primary/5 flex flex-col gap-5"
  >
    <div>
      <p
        class="text-xs font-mono tracking-widest uppercase text-primary mb-2"
      >
        Cuenta Demo
      </p>
      <h3 class="text-lg font-bold text-white mb-2">
        ¿Quieres probar la app tú mismo?
      </h3>
      {
        nota && (
          <p class="text-sm text-slate-400 max-w-xl">{nota}</p>
        )
      }
    </div>

    <div
      class="grid grid-cols-1 md:grid-cols-2 gap-3 max-w-xl"
    >
      <div
        class="bg-background/60 border border-slate-800 rounded-md p-3 flex items-center justify-between gap-3"
      >
        <div class="min-w-0 flex-1">
          <p
            class="text-[10px] font-mono uppercase tracking-widest text-slate-500 mb-1"
          >
            Correo
          </p>
          <p
            class="text-sm text-white font-mono truncate"
            data-copy-target={email}
          >
            {email}
          </p>
        </div>
        <button
          type="button"
          class="shrink-0 inline-flex items-center justify-center w-9 h-9 rounded-md bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-primary transition-colors"
          aria-label={`Copiar correo ${email}`}
          data-copy-btn={email}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-copy"
          >
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
            <path
              d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
            ></path>
          </svg>
        </button>
      </div>

      <div
        class="bg-background/60 border border-slate-800 rounded-md p-3 flex items-center justify-between gap-3"
      >
        <div class="min-w-0 flex-1">
          <p
            class="text-[10px] font-mono uppercase tracking-widest text-slate-500 mb-1"
          >
            Contraseña
          </p>
          <p
            class="text-sm text-white font-mono truncate"
            data-copy-target={password}
          >
            {password}
          </p>
        </div>
        <button
          type="button"
          class="shrink-0 inline-flex items-center justify-center w-9 h-9 rounded-md bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-primary transition-colors"
          aria-label={`Copiar contraseña`}
          data-copy-btn={password}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-copy"
          >
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
            <path
              d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
            ></path>
          </svg>
        </button>
      </div>
    </div>

    {
      demoUrl && (
        <div>
          <a
            href={demoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium bg-primary text-black hover:bg-primary/90 h-11 px-6 py-2 font-bold border border-transparent hover:scale-105 transition-transform"
            aria-label="Abrir demo en una pestaña nueva"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="lucide lucide-external-link"
            >
              <path d="M15 3h6v6"></path>
              <path d="M10 14 21 3"></path>
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            </svg>
            Visitar demo
          </a>
        </div>
      )
    }
  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(
    '[data-copy-btn]',
  );

  buttons.forEach((button) => {
    button.addEventListener('click', async () => {
      const value = button.getAttribute('data-copy-btn');
      if (!value) return;

      try {
        await navigator.clipboard.writeText(value);
        const original = button.innerHTML;
        button.innerHTML =
          '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check"><path d="M20 6 9 17l-5-5"></path></svg>';
        setTimeout(() => {
          button.innerHTML = original;
        }, 1500);
      } catch (err) {
        console.error('Copy failed', err);
      }
    });
  });
</script>
