---
export interface Props {
  title: string;
  underlineWidth?: string;
  id?: string;
}

const { title, underlineWidth = 'w-16', id } = Astro.props;
---

<h2
  id={id}
  class="text-2xl md:text-3xl font-bold mb-6 relative inline-block after:content-[''] after:block after:h-1 after:bg-primary after:mt-2"
  data-underline-width={underlineWidth}
  style={`--tw-after-w: ${underlineWidth};`}
>
  <span class={`after-wrapper block relative`}>{title}</span>
</h2>

<style>
  h2[data-underline-width='w-16']::after {
    width: 4rem;
  }
  h2[data-underline-width='w-29']::after {
    width: 7.25rem;
  }
</style>
