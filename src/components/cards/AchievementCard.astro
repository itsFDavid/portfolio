---
import type { Achievement } from '../../data/achievements';
import Tag from '../ui/Tag.astro';

export interface Props {
  achievement: Achievement;
}

const { achievement } = Astro.props;

const iconColorMap = {
  yellow: 'bg-yellow-100/80 text-yellow-600',
  blue: 'bg-blue-100/80 text-blue-600',
  green: 'bg-green-100/80 text-green-600',
} as const;

const achievementColor = achievement.icon === 'star'
  ? 'blue'
  : achievement.icon === 'award'
    ? 'green'
    : 'yellow';
---

<div
  class="min-w-[280px] max-w-[280px] md:min-w-[300px] md:max-w-[300px] bg-card p-4 md:p-6 rounded-lg shadow-sm border border-slate-800 snap-center select-none mt-2 hover:-translate-y-2 transition-transform duration-300 relative group"
>
  <div class="flex items-center mb-4">
    <div class:list={['p-2 rounded-full mr-3', iconColorMap[achievementColor]]}>
      {achievement.icon === 'trophy' && (
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lucide lucide-trophy h-4 w-4 md:h-5 md:w-5"
        >
          <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"></path>
          <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"></path>
          <path d="M4 22h16"></path>
          <path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"></path>
          <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"></path>
          <path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"></path>
        </svg>
      )}
      {achievement.icon === 'star' && (
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lucide lucide-star h-4 w-4 md:h-5 md:w-5"
        >
          <path
            d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.123 2.122 0 0 0 1.597-1.16z"
          ></path>
        </svg>
      )}
      {achievement.icon === 'award' && (
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lucide lucide-award h-4 w-4 md:h-5 md:w-5"
        >
          <path
            d="m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526"
          ></path>
          <circle cx="12" cy="8" r="6"></circle>
        </svg>
      )}
    </div>
    <div>
      <p class="text-sm text-slate-400">{achievement.year}</p>
      <h3 class="text-white text-sm md:text-base">{achievement.title}</h3>
    </div>
  </div>
  <p class="text-sm text-slate-400 mb-4 text-justify">{achievement.description}</p>
  <Tag label={achievement.category} variant="achievement" achievementColor={achievementColor} />
</div>
