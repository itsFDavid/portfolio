---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import About from "../components/sections/About.astro";
import Projects from "../components/sections/Projects.astro";
import Skills from "../components/sections/Skills.astro";
import Achievements from "../components/sections/Achievements.astro";
import Contact from "../components/sections/Contact.astro";
import { getProjects } from "../data/projects";
import { getAchievements } from "../data/achievements";
import { getSkills } from "../data/skills";
import { getLangFromUrl } from "../i18n/utils";
import { useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Francisco David",
  url: "https://itsfdavid.com/",
  image: "https://itsfdavid.com/images/francisco_david.webp",
  jobTitle: "Desarrollador Full Stack",
  sameAs: [
    "https://github.com/itsFdavid",
    "https://www.linkedin.com/in/francisco-david-dev/",
  ],
  worksFor: {
    "@type": "Organization",
    name: "Freelancer",
  },
};
---

<BaseLayout
  title={t("seo.title")}
  description={t("seo.description")}
  ogTitle={t("seo.ogTitle")}
  ogDescription={t("seo.ogDescription")}
  twitterTitle={t("seo.twitterTitle")}
  twitterDescription={t("seo.twitterDescription")}
  schemaJson={personSchema}
  enableHeaderScript={true}
  enableNotFoundScript={false}
  lang={lang}
>
  <ul class="list-none container mx-auto px-4">
    <Hero lang={lang} />
    <About lang={lang} />
    <Projects lang={lang} projects={getProjects(lang)} />
    <Skills lang={lang} skills={getSkills(lang)} />
    <Achievements lang={lang} achievements={getAchievements(lang)} />
    <Contact lang={lang} />
  </ul>

  <script is:inline>
    (function () {
      var KEY = "preferred-lang";
      if (localStorage.getItem(KEY)) return;

      var browserLang = (
        navigator.language ||
        navigator.languages?.[0] ||
        "es"
      ).toLowerCase();
      if (browserLang.startsWith("en")) {
        localStorage.setItem(KEY, "en");
        window.location.replace("/en/");
      } else {
        localStorage.setItem(KEY, "es");
      }
    })();
  </script>
</BaseLayout>
