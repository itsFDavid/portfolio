---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DetailHeader from '../../../components/ui/DetailHeader.astro';
import ProjectDetailContent from '../../../components/project-detail/ProjectDetailContent.astro';
import { getProjects } from '../../../data/projects';
import { getProjectDetails } from '../../../data/projectDetails';

const lang = 'en' as const;

export async function getStaticPaths() {
  const projects = getProjects('en');
  const details = getProjectDetails('en');
  return projects
    .filter((project) => project.detailUrl && details[project.id])
    .map((project) => ({
      params: { slug: project.id },
      props: { project },
    }));
}

const { project } = Astro.props;
const detail = getProjectDetails(lang)[project.id];

if (!project || !detail) {
  return Astro.redirect('/404');
}
---

<BaseLayout
  title={`${project.title} | Francisco David`}
  description={project.description}
  ogTitle={project.title}
  ogDescription={project.description}
  ogType="article"
  lang={lang}
>
  <ProjectDetailContent project={project} detail={detail} lang={lang}>
    <DetailHeader
      slot="header"
      eyebrow={detail.headerEyebrow}
      title={project.title}
      description={project.description}
      tags={project.tags}
    />
  </ProjectDetailContent>
</BaseLayout>